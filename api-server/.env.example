PORT=9000
CLIENT_URL=http://localhost:3000

# Upstash Redis (get from https://console.upstash.com)
REDIS_URL=rediss://default:xxxxx@xxx.upstash.io:6379

# Supabase (get from https://supabase.com/dashboard)
#   1. Create a project
#   2. Go to Project Settings → API
#   3. SUPABASE_URL = Project URL (e.g. https://xxxxx.supabase.co)
#   4. SUPABASE_SERVICE_KEY = service_role key (NOT the anon key)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGci...your_service_role_key

# Cloudflare Pages (get from https://dash.cloudflare.com)
#   1. Go to any page in the dashboard — your Account ID is in the URL or sidebar
#   2. Create an API Token: My Profile → API Tokens → Create Token
#      Use the "Edit Cloudflare Pages" template, or create a custom token with
#      Account > Cloudflare Pages > Edit permissions
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_API_TOKEN=your_cloudflare_api_token
